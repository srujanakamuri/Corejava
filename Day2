import java.util.Scanner;
public class evenoddtable {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("1. Even Tables");
        System.out.println("2. Odd Tables");
        System.out.println("Enter your choice:");
        int choice = sc.nextInt();
        if(choice == 1) {
            System.out.println("Even Multiplication Tables");
            for(int i = 2; i <= 40; i += 2) {
                System.out.println("\nMultiplication Table of " + i);
                for(int j = 1; j <= 10; j++) {
                    System.out.println(i + " x " + j + " = " + (i * j));
                }
            }
        } else if(choice == 2) {
            System.out.println("Odd Multiplication Tables");
            for(int i = 1; i <= 40; i += 2) {
                System.out.println("\nMultiplication Table of " + i);
                for(int j = 1; j <= 10; j++) {
                    System.out.println(i + " x " + j + " = " + (i * j));
                }
            }
        } else {
            System.out.println("Invalid Choice");
        }
        sc.close();
    }
}
