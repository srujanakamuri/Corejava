import java.util.Scanner;
public class whiletable {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter a number:");
        int n = sc.nextInt();
        int i = 1;
       do{
            System.out.println(n + " x " + i + " = " + (n * i));
            i++;
        }
        while(i<=10);
        sc.close();
    }
}
